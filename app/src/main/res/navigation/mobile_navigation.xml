<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_login">

    <fragment
        android:id="@+id/nav_login"
        android:name="com.example.dentalprueba.ui.LoginFragment"
        android:label="Iniciar Sesión"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_nav_login_to_nav_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/nav_login"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.dentalprueba.ui.HomeFragment"
        android:label="Agenda"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_nav_home_to_nav_patient_detail"
            app:destination="@+id/nav_patient_detail" />
    </fragment>

    <fragment
        android:id="@+id/nav_add_patient"
        android:name="com.example.dentalprueba.ui.AddPatientFragment"
        android:label="Agregar Paciente"
        tools:layout="@layout/fragment_add_patient" />

    <fragment
        android:id="@+id/nav_patient_detail"
        android:name="com.example.dentalprueba.ui.PatientDetailFragment"
        android:label="Detalle del Paciente"
        tools:layout="@layout/fragment_patient_detail" />
        
    <fragment
        android:id="@+id/nav_history"
        android:name="com.example.dentalprueba.ui.HistoryFragment"
        android:label="Historial Global"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/nav_finances"
        android:name="com.example.dentalprueba.ui.FinancesFragment"
        android:label="Mis Finanzas"
        tools:layout="@layout/fragment_finances" />

</navigation>
